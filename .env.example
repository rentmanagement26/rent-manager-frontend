# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Where the ASP.NET backend runs. No trailing slash. Production must be https.
BACKEND_API_URL=http://localhost:5156

# Signs the session cookie. Use a long random value (at least 32 characters), different in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
